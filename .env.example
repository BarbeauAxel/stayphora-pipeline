# Copier en .env (jamais commité) puis remplir. Chargé automatiquement par la CLI.

# Cloudflare R2 (jeton API R2 limité au bucket stayphora-assets, lecture/écriture)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Resend (notification e-mail)
RESEND_API_KEY=

# RunPod (uniquement sur le PC local, pour scripts/runpod_job.py)
RUNPOD_API_KEY=

# Optionnel : dossier de travail (sinon C:/stayphora-work ou /workspace/work)
# STAYPHORA_WORK_DIR=
